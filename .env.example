# WordPress REST API base URL (includes /wp-json prefix)
NUXT_PUBLIC_WP_API_BASE=https://green-paws-lms-backend.ddev.site/wp-json

# JWT auth endpoints base (vl-jwt-auth namespace)
NUXT_PUBLIC_WP_AUTH_BASE=https://green-paws-lms-backend.ddev.site/wp-json/vl-auth/v1

# Internal URL used during SSR on server (optional, for Docker setups)
# NUXT_WP_API_BASE_INTERNAL=http://wordpress:80/wp-json

# Public site URL (no trailing slash). Used by sitemap.xml, robots.txt,
# and JSON-LD structured data on landing pages.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
